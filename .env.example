# Plantilla de variables de entorno. Cópiala a `.env` (dev) y rellena los
# valores de TU proyecto de Supabase. Nunca subas `.env` al repositorio.
# Ver docs/arquitectura/Entornos.md.

# --- Supabase: URL y claves del proyecto (Project Settings → API) ------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref-de-tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave-publicable>
# Solo servidor y scripts: salta RLS. NUNCA con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<clave-secreta>

# --- Guarda de entorno (lib/entorno.ts) ----------------------------------------
# El ref es el subdominio de la URL. Sin SUPABASE_REF_DEV, las pruebas y la
# siembra se niegan a correr (la guarda falla cerrada).
SUPABASE_REF_DEV=<ref-del-proyecto-de-dev>
SUPABASE_REF_PRODUCCION=<ref-del-proyecto-de-produccion>

# --- Usuario de prueba para el E2E y verificar:sesion-revocada (opcional) -------
USUARIO_PRUEBA_CORREO=<correo-del-usuario-de-prueba>
USUARIO_PRUEBA_CLAVE=<clave-del-usuario-de-prueba>

# --- Importación del catálogo de medicamentos desde Google Sheets (opcional) ----
# Service Account de Google en JSON, codificada en base64 (una sola línea).
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=<json-de-la-service-account-en-base64>
GOOGLE_SHEET_ID_MEDICAMENTOS=<id-del-sheet>
# GOOGLE_SHEET_RANGE_MEDICAMENTOS=Medicamentos!A:B

# --- Respaldos (scripts/respaldo) ------------------------------------------------
# Session pooler, puerto 5432 (el transaction pooler, 6543, no sirve para pg_dump):
#   postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Solo scripts/verificar-migraciones.mjs (opcional) --------------------------
# Token personal de la Management API de Supabase.
SUPABASE_ACCESS_TOKEN=
